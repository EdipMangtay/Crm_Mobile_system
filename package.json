{
  "name": "trivia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/website",
    "apps/crm",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "concurrently -n website,crm -c cyan,magenta \"npm run dev:website\" \"npm run dev:crm\"",
    "dev:website": "npm run dev --workspace=apps/website",
    "dev:crm": "npm run dev --workspace=apps/crm",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:all": "concurrently -n website,crm,mobile -c cyan,magenta,green \"npm run dev:website\" \"npm run dev:crm\" \"npm run dev:mobile\"",
    "build": "npm run build:crm && npm run build:website",
    "build:website": "npm run build --workspace=apps/website",
    "build:crm": "npm run build --workspace=apps/crm",
    "lint:website": "npm run lint --workspace=apps/website",
    "lint:crm": "npm run lint --workspace=apps/crm",
    "typecheck:mobile": "npm run typecheck --workspace=apps/mobile"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
