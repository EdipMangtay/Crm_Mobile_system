# ═══════════════════════════════════════════════════════════════
# TRAVELOS MOBILE — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env or actual secrets
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (Public — safe for mobile client) ────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── API (Public — safe for mobile client) ─────────────────────
# Local: CRM/backend on port 3001
# Production builds MUST use the deployed CRM HTTPS origin, not the public website.
# Do not hardcode a production domain here until that origin is chosen.
EXPO_PUBLIC_API_URL=http://localhost:3001
