# ═══════════════════════════════════════════════════════════════
# TRAVELOS CRM — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local or actual secrets
# ═══════════════════════════════════════════════════════════════

# ─── Application URLs ──────────────────────────────────────────
NEXT_PUBLIC_CRM_URL=http://localhost:3001
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# ─── Supabase (Public — safe for browser) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (Server-only — NEVER expose to browser) ─────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI (Server-only — for AI Copilot) ────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ─── Demo Mode ─────────────────────────────────────────────────
# Set to "true" to enable demo seed data and demo login
# MUST be "false" or unset in production
TRAVIA_DEMO_MODE=false
