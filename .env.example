# TravelOS monorepo — copy the per-app examples, not this file:
#   apps/website/.env.example  →  apps/website/.env.local
#   apps/crm/.env.example      →  apps/crm/.env.local
#   apps/mobile/.env.example   →  apps/mobile/.env
#
# Local topology:
#   Website  http://localhost:3000
#   CRM/API  http://localhost:3001
#   Mobile   Expo / Metro (normally 8081)
